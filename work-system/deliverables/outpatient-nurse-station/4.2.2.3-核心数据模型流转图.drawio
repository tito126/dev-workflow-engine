<mxfile host="app.diagrams.net" modified="2026-04-22T04:10:00.000Z" agent="OpenClaw" version="24.7.17">
  <diagram id="outpatient-banner-data-model-flow" name="4.2.2.3 核心数据模型流转图">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="4.2.2.3 门诊护士站患者 Banner 核心数据模型流转图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="20" width="1080" height="40" as="geometry"/></mxCell>
        <mxCell id="note" value="说明：固定信息（头像、序号、性别、年龄）直接展示；其他信息由 Banner 基础显示项定义与病区展示配置共同驱动。INP_BANNER_DISPLAY_ADAPT 为基础项主表，BANNER_DISPLAY_WARD_SETTINGS 为病区具体展示配置表，两者为一对多关系。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="160" y="72" width="1480" height="68" as="geometry"/></mxCell>

        <mxCell id="layer1" value="来源层" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="120" height="30" as="geometry"/></mxCell>
        <mxCell id="layer2" value="处理层" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="180" width="120" height="30" as="geometry"/></mxCell>
        <mxCell id="layer3" value="数据层" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="180" width="120" height="30" as="geometry"/></mxCell>
        <mxCell id="layer4" value="使用层" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1480" y="180" width="120" height="30" as="geometry"/></mxCell>

        <mxCell id="srcCfgBase" value="统一配置&#xa;Banner 基础显示项维护" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="250" height="86" as="geometry"/></mxCell>
        <mxCell id="srcCfgWard" value="统一配置&#xa;病区 Banner 展示配置维护" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="250" height="86" as="geometry"/></mxCell>
        <mxCell id="srcPatient" value="患者实时上下文&#xa;病区、就诊类型、急诊类型、患者属性值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="250" height="96" as="geometry"/></mxCell>
        <mxCell id="srcFixed" value="产品固定展示要求&#xa;头像、序号、性别、年龄" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="250" height="86" as="geometry"/></mxCell>

        <mxCell id="procBase" value="基础显示项定义加载&#xa;读取显示项标识、属性名、默认标志、排序" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="240" width="300" height="86" as="geometry"/></mxCell>
        <mxCell id="procWard" value="病区配置匹配&#xa;按病区 / 就诊类型 / 急诊类型选择配置" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="370" width="300" height="86" as="geometry"/></mxCell>
        <mxCell id="procAssemble" value="Banner 组装处理&#xa;默认项补齐、排序、样式合并、一对多映射" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="500" width="300" height="96" as="geometry"/></mxCell>
        <mxCell id="procRender" value="运行时渲染处理&#xa;PROPERTY_NAME 动态取值 + BANNER_DISPLAY_ITEM_VALUE 固定值输出" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="640" width="300" height="96" as="geometry"/></mxCell>

        <mxCell id="tblAdapt" value="INP_BANNER_DISPLAY_ADAPT&#xa;病区适配 Banner 显示项表&#xa;基础项主表" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="850" y="250" width="280" height="88" as="geometry"/></mxCell>
        <mxCell id="tblWard" value="BANNER_DISPLAY_WARD_SETTINGS&#xa;Banner 显示病区配置表&#xa;具体展示配置表" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="850" y="430" width="280" height="88" as="geometry"/></mxCell>
        <mxCell id="tblRelation" value="关系约束&#xa;1 个基础显示项&#xa;对应 N 条病区展示配置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="590" width="180" height="92" as="geometry"/></mxCell>
        <mxCell id="tblKeys" value="关键字段&#xa;BANNER_DISPLAY_ITEM_ID&#xa;WARD_ID / SEQ_NO / PROPERTY_NAME&#xa;ENCOUNTER_TYPE_CODE / EMERGENCY_TYPE_CODE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="830" y="730" width="320" height="108" as="geometry"/></mxCell>

        <mxCell id="useBanner" value="门诊护士站患者 Banner&#xa;固定信息 + 动态配置项展示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1420" y="300" width="280" height="96" as="geometry"/></mxCell>
        <mxCell id="useHover" value="一行展示不下时&#xa;支持鼠标悬浮查看" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1420" y="470" width="280" height="86" as="geometry"/></mxCell>
        <mxCell id="useStyle" value="样式输出&#xa;背景色、字体色、排序结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1420" y="620" width="280" height="86" as="geometry"/></mxCell>

        <mxCell id="e1" value="维护基础项" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="srcCfgBase" target="procBase"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="写基础定义" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="procBase" target="tblAdapt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="维护病区配置" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="srcCfgWard" target="procWard"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="写病区配置" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="procWard" target="tblWard"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="上下文参与匹配" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="srcPatient" target="procAssemble"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="固定项直接参与渲染" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=13;strokeColor=#82b366;" edge="1" parent="1" source="srcFixed" target="procRender"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="关联键：BANNER_DISPLAY_ITEM_ID" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="tblAdapt" target="procAssemble"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="按病区场景取配置" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="tblWard" target="procAssemble"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="默认项补齐 / 排序 / 样式合并" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="procAssemble" target="procRender"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="基础项 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1;fontSize=13;strokeColor=#666666;" edge="1" parent="1" source="tblAdapt" target="tblRelation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="病区配置 N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1;fontSize=13;strokeColor=#666666;" edge="1" parent="1" source="tblRelation" target="tblWard"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="约束字段说明" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1;fontSize=13;strokeColor=#666666;" edge="1" parent="1" source="tblRelation" target="tblKeys"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="输出 Banner 内容" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="procRender" target="useBanner"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="一行不足时悬浮展示" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="useBanner" target="useHover"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="样式呈现" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="tblWard" target="useStyle"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="默认排序 / 属性映射" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="tblAdapt" target="useBanner"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
